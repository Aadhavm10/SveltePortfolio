---
// Static loader: shows instantly (before any JS bundle) but only fades in
// if loading takes longer than ~300ms. GlobeExperience drives progress.
---

<div id="globe-loader" class="globe-loader" role="status" aria-live="polite">
  <div class="inner">
    <canvas class="mini-globe" width="120" height="120" aria-hidden="true"></canvas>
    <div class="mono">AM</div>
    <div class="row"><span data-status>loading map…</span><b data-pct>0%</b></div>
    <div class="bar"><i data-bar></i></div>
  </div>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('globe-loader');
    if (!el) return;
    var canvas = el.querySelector('.mini-globe');
    var ctx = canvas.getContext('2d');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var S = 120;
    canvas.width = S * dpr;
    canvas.height = S * dpr;
    canvas.style.width = S + 'px';
    canvas.style.height = S + 'px';
    ctx.scale(dpr, dpr);
    var R = 46, cx = S / 2, cy = S / 2, tilt = 0.38;
    var start = performance.now();

    // Orthographic wireframe globe with a tilted axis.
    function project(lat, lng, rot) {
      var phi = lat, lam = lng + rot;
      var x = Math.cos(phi) * Math.sin(lam);
      var y = Math.sin(phi);
      var z = Math.cos(phi) * Math.cos(lam);
      var y2 = y * Math.cos(tilt) - z * Math.sin(tilt);
      var z2 = y * Math.sin(tilt) + z * Math.cos(tilt);
      return [cx + x * R, cy - y2 * R, z2];
    }
    function line(points) {
      for (var i = 1; i < points.length; i++) {
        var a = points[i - 1], b = points[i];
        var front = (a[2] + b[2]) / 2 > 0;
        ctx.strokeStyle = front ? 'rgba(124,196,255,0.85)' : 'rgba(124,196,255,0.16)';
        ctx.beginPath();
        ctx.moveTo(a[0], a[1]);
        ctx.lineTo(b[0], b[1]);
        ctx.stroke();
      }
    }
    function draw(now) {
      if (!document.body.contains(el)) return;
      var rot = ((now - start) / 1000) * 0.9;
      ctx.clearRect(0, 0, S, S);
      ctx.lineWidth = 1;
      var i, j, pts;
      for (i = 0; i < 12; i++) {
        pts = [];
        for (j = 0; j <= 48; j++) pts.push(project(-Math.PI / 2 + (Math.PI * j) / 48, (Math.PI * 2 * i) / 12, rot));
        line(pts);
      }
      for (i = -2; i <= 2; i++) {
        pts = [];
        for (j = 0; j <= 72; j++) pts.push(project((i * Math.PI) / 6, (Math.PI * 2 * j) / 72, rot));
        line(pts);
      }
      ctx.strokeStyle = 'rgba(124,196,255,0.9)';
      ctx.lineWidth = 1.4;
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.stroke();
      requestAnimationFrame(draw);
    }

    window.__globeLoaderTimer = setTimeout(function () {
      if (el.dataset.done) return;
      el.dataset.shownAt = String(performance.now());
      el.classList.add('show');
      requestAnimationFrame(draw);
    }, 300);
  })();
</script>

<style>
  .globe-loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at 50% 55%, #0a1430 0%, #04060c 55%, #020305 100%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
    color: #fff;
  }

  .globe-loader:global(.show) {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease;
  }

  .globe-loader:global(.leaving) {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease 0.15s, visibility 0s linear 0.75s;
  }

  .inner {
    width: min(320px, 80vw);
    text-align: center;
    transition: transform 0.7s cubic-bezier(0.6, 0, 0.2, 1);
  }

  .globe-loader:global(.leaving) .mini-globe {
    transform: scale(4);
    opacity: 0;
  }

  .mini-globe {
    display: block;
    margin: 0 auto;
    filter: drop-shadow(0 0 18px rgba(59, 130, 255, 0.55));
    transition: transform 0.75s cubic-bezier(0.6, 0, 0.2, 1), opacity 0.6s ease;
  }

  .mono {
    margin-top: 18px;
    font-size: 42px;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .row {
    margin-top: 18px;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .row b {
    color: #fff;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .bar {
    margin-top: 9px;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  .bar i {
    display: block;
    height: 100%;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left;
    border-radius: 3px;
    background: linear-gradient(90deg, #ff6b6b, #ffe66d, #4ecdc4);
    box-shadow: 0 0 14px rgba(78, 205, 196, 0.8);
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import ProjectShowcase from '../components/ProjectShowcase.svelte';
import Prism from '../components/Prism.tsx';
import { projects } from '../data/portfolio';
---

<Layout
  title="Projects | Aadhav's Portfolio"
  description="Explore Aadhav Manimurugan's portfolio of web development and machine learning projects"
>
  <div class="container">
    <div class="prism-background">
      <Prism
        client:idle
        glow={0.7}
        bloom={1}
        colorFrequency={1}
        noise={0.5}
        scale={4}
        height={3.5}
        baseWidth={5.5}
        offset={{ x: 0, y: -100 }}
      />
    </div>
    <div class="content-layer">
      <ProjectShowcase client:load projects={projects} />
    </div>
  </div>
</Layout>

<style>
  .container {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #0a0a0a;
  }

  .prism-background {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .content-layer {
    position: relative;
    z-index: 10;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import ProjectShowcase from '../components/ProjectShowcase.svelte';
import Prism from '../components/Prism.tsx';

const projects = [
  {
    src: "/projectpics/HackMatch.png",
    title: "HackMatch",
    description: "AI facilitator that guides hackathon teams from brainstorm to MVP: Cloudflare Workers AI scores ideas, suggests tech stacks, and drafts a product requirements doc, with live collaboration over WebSockets.",
    projectUrl: "https://github.com/Aadhavm10/cf_ai_hackmatch"
  },
  {
    src: "/projectpics/ScribbleAi.png",
    title: "ScribblyAI",
    description: "AI note-taking app with hybrid keyword and vector search and AI answers grounded in your notes, on an event-driven NestJS and Kafka backend.",
    projectUrl: "https://github.com/Aadhavm10/ScribblyAi"
  },
  {
    src: "/projectpics/flowstate.png",
    title: "FlowState",
    description: "Generates AI-powered playlists and visualizes music in 3D, drawing on Every Noise at Once genre data, with visuals that respond to the music in real time.",
    projectUrl: "https://flowstate-music.vercel.app/"
  },
  {
    src: "/projectpics/gpu-optimizer.png",
    title: "GPU Optimizer",
    description: "Real-time NVIDIA GPU monitoring dashboard (NVML + Dash) and four CUDA matrix-multiply kernels, each checked against a CPU reference; the fastest runs 2.9x faster than the naive kernel on a Tesla T4.",
    projectUrl: "https://github.com/Aadhavm10/GPU_Optimizer"
  },
  {
    src: "/projectpics/FantasyPremierLeague.png",
    title: "PremScout",
    description: "Fantasy Premier League Points Predictor using machine learning algorithms to analyze player performance and predict fantasy points.",
    projectUrl: "https://prem-scout.vercel.app/"
  }
];
---

<Layout
  title="Projects | Aadhav's Portfolio"
  description="Explore Aadhav Manimurugan's portfolio of web development and machine learning projects"
>
  <div class="container">
    <div class="prism-background">
      <Prism
        client:idle
        glow={0.7}
        bloom={1}
        colorFrequency={1}
        noise={0.5}
        scale={4}
        height={3.5}
        baseWidth={5.5}
        offset={{ x: 0, y: -100 }}
      />
    </div>
    <div class="content-layer">
      <ProjectShowcase client:load projects={projects} />
    </div>
  </div>
</Layout>

<style>
  .container {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: #0a0a0a;
  }

  .prism-background {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .content-layer {
    position: relative;
    z-index: 10;
  }
</style>
